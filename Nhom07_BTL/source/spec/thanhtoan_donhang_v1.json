  "arithmetic_checks": [
    {
      "name": "order_total_int32",
      "int_vars": [
        "subtotal",
        "shipping_fee"
      ],
      "condition": "subtotal >= 0 and subtotal <= 2000000000 and shipping_fee >= 0 and shipping_fee <= 500000 and subtotal + shipping_fee > 2147483647",
      "overflow_expr": "subtotal + shipping_fee"
    },
    {
      "name": "line_amount_mul",
      "int_vars": [
        "price",
        "qty"
      ],
      "condition": "price >= 0 and price <= 50000000 and qty >= 1 and qty <= 1000 and price * qty <= 50000000 and price * qty > 2147483647",
      "overflow_expr": "price * qty"
    },
    {
      "name": "accumulated_total",
      "int_vars": [
        "total_before",
        "line_total"
      ],
      "condition": "total_before >= 0 and line_total >= 0 and line_total <= 50000000 and total_before <= 2000000000 - line_total and total_before + line_total > 2147483647",
      "overflow_expr": "total_before + line_total"
    },
    {
      "name": "alloc_bytes",
      "int_vars": [
        "n_items",
        "item_size"
      ],
      "condition": "n_items >= 1 and n_items <= 100 and item_size == 48 and n_items * item_size > 2147483647",
      "overflow_expr": "n_items * item_size"
    },
    {
      "name": "negative_total",
      "int_vars": [
        "subtotal",
        "discount"
      ],
      "condition": "subtotal >= 0 and subtotal <= 2000000000 and discount >= 0 and discount <= subtotal and subtotal - discount < 0",
      "overflow_expr": "subtotal - discount"
    },
    {
      "name": "bmc_cong_don_don_hang",
      "int_vars": [
        "i",
        "total"
      ],
      "bmc_init": {
        "i": 0,
        "total": 0
      },
      "bmc_step": "i = i + 1; total = total + 45000000",
      "bmc_cond": "i < 100 and total + 45000000 <= 2000000000",
      "bmc_assert": "total <= 2147483647",
      "bmc_k": 100
    }
  ],
